# Nothing secret is needed: the dataset is public and everything runs offline.
# Optional: where the downloaded data goes (default: ./data)
REVIEWS_DATA_DIR=./data

# Optional: pin the model hashes the CLI accepts. A pinned hash beats the manifest saved next to
# the model, so swapping both the model file and its manifest is still caught.
# REVIEWS_MODEL_SHA256=
# REVIEWS_TOPICS_SHA256=
